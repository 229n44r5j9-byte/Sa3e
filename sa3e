</nav>

<div class="ov" id="ov"></div>
<div class="sheet glass" id="sheet"></div>
<div class="lb" id="lb"><button class="glass" onclick="lbClose()"><svg class="i"><use href="#x"/></svg></button><img id="lbImg" alt=""></div>
<div class="toast glass" id="toast"></div>

<script>
const DB = "https://elsho3l-default-rtdb.firebaseio.com";
const WHATSAPP = "201203835674";
const PHONE_DISPLAY = "+20 120 383 5674";
const GOVS = ["القاهرة","الجيزة","الإسكندرية","القليوبية","الشرقية","الدقهلية","البحيرة","المنوفية","الغربية","كفر الشيخ","دمياط","بورسعيد","الإسماعيلية","السويس","شمال سيناء","جنوب سيناء","الفيوم","بني سويف","المنيا","أسيوط","سوهاج","قنا","الأقصر","أسوان","البحر الأحمر","الوادي الجديد","مطروح"];
const DEF = {marquee:"خصومات آخر الصيف لفترة محدودة",heroTitle:"أناقة تبدأ من <em>راحتك</em>",heroSub:"تشكيلة مختارة بعناية — توصيل لكل المحافظات",shipping:60,hero:"",reviews:[]};

/* منع الزوم نهائياً على الموبايل */
let lastTouch = 0;
document.addEventListener("touchend", e => {
  const now = Date.now();
  if(now - lastTouch <= 300) e.preventDefault();
  lastTouch = now;
}, {passive:false});
document.addEventListener("gesturestart", e => e.preventDefault());

const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const ic = n => `<svg class="i"><use href="#${n}"/></svg>`;
const fmt = n => "LE " + Number(n).toLocaleString("en", {minimumFractionDigits:2, maximumFractionDigits:2});
const ph = (t, a="#4c1d95", b="#ec4899") => "data:image/svg+xml;utf8," + encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 400'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='${a}'/><stop offset='1' stop-color='${b}'/></linearGradient></defs><rect width='300' height='400' fill='url(#g)'/><text x='150' y='205' fill='white' fill-opacity='.8' font-size='20' text-anchor='middle' font-family='sans-serif'>${t}</text></svg>`);
let store = {get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}}, set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
async function api(path, method="GET", body){
  const r = await fetch(`${DB}/${path}.json`, {method, headers:{"Content-Type":"application/json"}, body: body===undefined?undefined:JSON.stringify(body)});
  if(!r.ok) throw new Error(r.status); return r.json();
}
function toast(t){const e=$("#toast");e.textContent=t;e.classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove("show"),2400)}

let products = [], settings = {...DEF}, cart = store.get("saay_cart", []), myOrderIds = store.get("saay_orders", []), loaded = false;
const demo = [
  {id:"d1",name:"بيجامة برجندي راوند",price:670,oldPrice:1070,sizeLabel:"المقاس: مقاس 2 من 90 ل 120 كيلو",sizes:["مقاس 2 من 90 ل 120 كيلو"],stock:17,images:[ph("ضع صورتك هنا","#5b1030","#2b1b4d")],desc:"قماش ناعم ومريح، مناسب للارتداء اليومي والنوم."},
  {id:"d2",name:"بيجامة رمادي راوند",price:670,oldPrice:1070,sizeLabel:"المقاس: مقاس 2 من 90 ل 120 كيلو",sizes:["مقاس 2 من 90 ل 120 كيلو"],stock:12,images:[ph("ضع صورتك هنا","#334155","#7c3aed")],desc:""},
  {id:"d3",name:"لوجين",price:299,oldPrice:0,sizeLabel:"المقاس",sizes:["S","M","L","XL"],stock:30,images:[ph("ضع صورتك هنا","#2563eb","#ec4899")],desc:""},
  {id:"d4",name:"بيجامة ساتان",price:640,oldPrice:870,sizeLabel:"المقاس",sizes:["S","M","L"],stock:8,images:[ph("ضع صورتك هنا","#7c3aed","#f59e0b")],desc:""}
];
const list = () => products.length ? products : demo;
const byId = id => list().find(p => p.id === id);
const disc = p => p.oldPrice > p.price ? Math.round((1 - p.price/p.oldPrice)*100) : 0;
const saveCart = () => { store.set("saay_cart", cart); updBadge(); };
const count = () => cart.reduce((a,i)=>a+i.qty,0);
function updBadge(bump){
  ["hBadge","nBadge"].forEach(id=>{const b=$("#"+id);b.textContent=count();b.style.display=count()?"grid":"none";if(bump){b.classList.remove("bump");void b.offsetWidth;b.classList.add("bump")}});
}

async function load(){
  try{
    const [p,s] = await Promise.all([api("products"), api("settings")]);
    products = p ? Object.entries(p).map(([id,v])=>({id,images:[],sizes:[],...v})) : [];
    if(s) settings = {...DEF, ...s, reviews: s.reviews ? Object.values(s.reviews) : []};
  }catch(e){}
  loaded = true;
  $("#marq").innerHTML = [1,2,3,4].map(()=>`<span>${esc(settings.marquee)}</span><span>${esc(settings.marquee)}</span>`).join("");
  $("#waBtn").href = `https://wa.me/${WHATSAPP}`;
}

function card(p){
  const d = disc(p), out = p.stock <= 0;
  return `<article class="card glass rv" data-id="${esc(p.id)}">
    <div class="ph">${d?`<span class="tag">-${d}%</span>`:""}${out?'<div class="sold">نفدت الكمية</div>':""}
      <img loading="lazy" src="${esc(p.images?.[0]||ph("سعي"))}" alt="${esc(p.name)}">
      <button class="qa glass" data-add="${esc(p.id)}" aria-label="أضف للسلة">${ic("cart")}</button></div>
    <h3>${esc(p.name)}</h3>
    <div class="pr">${p.oldPrice>p.price?`<b>${fmt(p.price)}</b><s>${fmt(p.oldPrice)}</s>`:fmt(p.price)}</div></article>`;
}
function home(){
  const rv = settings.reviews || [];
  return `<div class="view">
    <section class="hero glass rv"><div class="bg" style="background-image:url('${esc(settings.hero||ph("ضع صورة الغلاف من لوحة التحكم","#3b1a7a","#be185d"))}')"></div><div class="shade"></div>
      <div><h1>${settings.heroTitle}</h1><p>${esc(settings.heroSub)}</p></div></section>
    ${rv.length?`<h2 class="sec-title rv">آراء عملائنا</h2><div class="rev rv">${rv.map(u=>`<div class="glass"><img loading="lazy" src="${esc(u)}" alt=""></div>`).join("")}</div>`:""}
    <h2 class="sec-title rv" id="prods">عملائنا اشتروا أيضًا</h2>
    <div class="grid">${loaded?list().map(card).join(""):'<div class="skel"></div>'.repeat(4)}</div>
    <footer class="rv"><div class="logo">سعي<small>SAAY</small></div>للتواصل والطلبات<br><a href="https://wa.me/${WHATSAPP}" target="_blank" dir="ltr" style="color:#fff;font-weight:700">${PHONE_DISPLAY}</a></footer>
  </div>`;
}
let cur = {pid:null, img:0, size:0, qty:1};
function product(id){
  const p = byId(id); if(!p) return `<div class="empty">المنتج غير موجود</div>`;
  cur = {pid:id, img:0, size:0, qty:1};
  const d = disc(p), imgs = p.images?.length ? p.images : [ph("سعي")];
  return `<div class="view">
    <a href="#/" class="back glass">${ic("back")} رجوع</a>
    <div class="gal glass"><div class="main" id="gMain">${d?`<span class="tag">-${d}%</span>`:""}<img id="gImg" src="${esc(imgs[0])}" alt=""><button class="exp glass" onclick="lbOpen()" aria-label="تكبير">${ic("exp")}</button></div>
      ${imgs.length>1?`<div class="thumbs">${imgs.map((u,i)=>`<button class="${i?"":"on"}" data-th="${i}"><img src="${esc(u)}" alt=""></button>`).join("")}</div>`:""}</div>
    <h1 class="ptitle">${esc(p.name)}</h1>
    <div class="pprice">${p.oldPrice>p.price?`<b>${fmt(p.price)}</b><s>${fmt(p.oldPrice)}</s>`:`<span>${fmt(p.price)}</span>`}</div>
    ${d?`<span class="save">SAVE LE ${(p.oldPrice-p.price).toLocaleString("en")}</span>`:""}
    ${p.sizes?.length?`<div class="opt">${esc(p.sizeLabel||"المقاس")}<div class="chips">${p.sizes.map((s,i)=>`<button class="chip ${i?"":"on"}" data-sz="${i}">${esc(s)}</button>`).join("")}</div></div>`:""}
    <div class="qty glass"><button data-q="1">${ic("plus")}</button><span id="qv">1</span><button data-q="-1">${ic("minus")}</button></div>
    <button class="btn p" id="addBtn">${ic("cart")} أضف إلى السلة</button>
    <button class="btn d" id="buyBtn">${ic("bag")} اطلب الآن</button>
    <div class="stock">${p.stock>0?`متبقي <b>${p.stock}</b> في المخزون`:"نفدت الكمية"}</div>
    ${p.desc?`<div class="desc glass">${esc(p.desc)}</div>`:""}
    <h2 class="sec-title rv">عملائنا اشتروا أيضًا</h2>
    <div class="grid">${list().filter(x=>x.id!==id).slice(0,4).map(card).join("")}</div>
  </div>`;
}

function route(){
  const h = location.hash || "#/", app = $("#app");
  closeSheet(); window.scrollTo({top:0});
  if(h.startsWith("#/p/")){ app.innerHTML = product(decodeURIComponent(h.slice(4))); setNav(1); }
  else { app.innerHTML = home(); setNav(1); }
  observe(); bindTilt();
}
function observe(){
  const io = new IntersectionObserver(es=>es.forEach((e,i)=>{if(e.isIntersecting){setTimeout(()=>e.target.classList.add("in"),(e.target.dataset.d||0)*70);io.unobserve(e.target)}}),{threshold:.08});
  document.querySelectorAll(".rv").forEach((el,i)=>{el.dataset.d=i%4;io.observe(el)});
}
function bindTilt(){
  if(matchMedia("(hover:none)").matches) return;
  document.querySelectorAll(".card").forEach(c=>{
    c.addEventListener("pointermove",e=>{const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;
      c.style.transform=`perspective(800px) rotateY(${(x-.5)*-10}deg) rotateX(${(y-.5)*10}deg) translateY(-4px)`;c.style.setProperty("--mx",x*100+"%");c.style.setProperty("--my",y*100+"%")});
    c.addEventListener("pointerleave",()=>c.style.transform="");
  });
}
function setNav(i){
  document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("on",+b.dataset.n===i));
  $("#pill").style.transform = `translateX(${-i*100}%)`;
}

document.addEventListener("pointermove",e=>{const g=e.target.closest?.(".glass");if(g){const r=g.getBoundingClientRect();g.style.setProperty("--mx",(e.clientX-r.left)+"px");g.style.setProperty("--my",(e.clientY-r.top)+"px")}});
document.addEventListener("click",e=>{
  const b = e.target.closest(".btn,.qa,.chip");
  if(b){const r=b.getBoundingClientRect(),s=Math.max(r.width,r.height)/3,sp=document.createElement("span");sp.className="rip";sp.style.cssText=`width:${s}px;height:${s}px;left:${e.clientX-r.left-s/2}px;top:${e.clientY-r.top-s/2}px`;b.style.position=b.style.position||"relative";b.appendChild(sp);setTimeout(()=>sp.remove(),700)}
  const add = e.target.closest("[data-add]");
  if(add){e.stopPropagation();const p=byId(add.dataset.add);addToCart(p,0,1);return}
  const c = e.target.closest(".card");
  if(c){location.hash = "#/p/"+encodeURIComponent(c.dataset.id);return}
  const th = e.target.closest("[data-th]");
  if(th){cur.img=+th.dataset.th;const p=byId(cur.pid);$("#gImg").src=p.images[cur.img];document.querySelectorAll(".thumbs button").forEach((x,i)=>x.classList.toggle("on",i===cur.img))}
  const sz = e.target.closest("[data-sz]");
  if(sz){cur.size=+sz.dataset.sz;document.querySelectorAll(".chip").forEach((x,i)=>x.classList.toggle("on",i===cur.size))}
  const q = e.target.closest("[data-q]");
  if(q){const p=byId(cur.pid);cur.qty=Math.max(1,Math.min(p.stock||99,cur.qty+ +q.dataset.q));$("#qv").textContent=cur.qty}
  if(e.target.closest("#addBtn")){addToCart(byId(cur.pid),cur.size,cur.qty)}
  if(e.target.closest("#buyBtn")){addToCart(byId(cur.pid),cur.size,cur.qty,true);openCart()}
});
$("#hCart").onclick = $("#nCart").onclick = () => openCart();
$("#hMenu").onclick = $("#nMenu").onclick = () => openMenu();
$("#nHome").onclick = () => { location.hash.length>2 ? location.hash="#/" : window.scrollTo({top:0}) };
$("#ov").onclick = closeSheet;
$("#up").onclick = () => window.scrollTo({top:0,behavior:"smooth"});
addEventListener("scroll",()=>$("#up").classList.toggle("show",scrollY>500),{passive:true});
addEventListener("hashchange",route);

function addToCart(p,si,qty,silent){
  if(!p) return; if(p.stock<=0) return toast("نفدت الكمية");
  const size = p.sizes?.[si] || "";
  const ex = cart.find(i=>i.id===p.id&&i.size===size);
  ex ? ex.qty += qty : cart.push({id:p.id,name:p.name,price:p.price,img:p.images?.[0]||"",size,qty});
  saveCart(); updBadge(true); if(!silent) toast("تمت الإضافة إلى السلة ✓");
}

function openSheet(html){
  const s=$("#sheet"); s.innerHTML = `<div class="grab"></div><button class="x glass" onclick="closeSheet()">${ic("x")}</button>`+html;
  $("#ov").classList.add("show"); requestAnimationFrame(()=>s.classList.add("show")); document.body.classList.add("lock"); s.scrollTop=0;
}
function closeSheet(){$("#sheet").classList.remove("show");$("#ov").classList.remove("show");document.body.classList.remove("lock")}
function openMenu(){
  openSheet(`<div style="padding-top:34px">
    <a href="#/" onclick="closeSheet()" class="btn g" style="justify-content:flex-start">${ic("home")} الرئيسية</a>
    <a href="#/" onclick="closeSheet();setTimeout(()=>document.getElementById('prods')?.scrollIntoView({behavior:'smooth'}),150)" class="btn g" style="justify-content:flex-start">${ic("bag")} المنتجات</a>
    <button type="button" onclick="openMyOrders()" class="btn g" style="justify-content:flex-start">${ic("note")} متابعة حالة الطلبات</button>
    <a class="btn g" style="justify-content:flex-start" href="https://wa.me/${WHATSAPP}" target="_blank">${ic("wa")} واتساب</a>
    <a class="btn p" href="tel:+${WHATSAPP}">${ic("phone")} <span dir="ltr">${PHONE_DISPLAY}</span></a>
  </div>`);
}

async function openMyOrders(){
  openSheet(`<div style="padding-top:34px"><h2 style="margin-bottom:14px">حالة طلباتك</h2><div id="myOrdBox"><p class="empty">جاري التحميل...</p></div></div>`);
  try{
    const all = await api("orders");
    const mine = all ? Object.entries(all).filter(([id])=>myOrderIds.includes(id)).reverse() : [];
    $("#myOrdBox").innerHTML = mine.length ? mine.map(([id,o])=>`
      <div class="glass" style="padding:14px;border-radius:20px;margin-bottom:12px;font-size:13px;line-height:1.9">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <b>طلب #${id.slice(-6).toUpperCase()}</b>
          <span class="st-pill">${esc(o.status || "قيد المراجعة")}</span>
        </div>
        <div style="margin-top:6px;color:var(--mute)">${(o.items||[]).map(i=>`${esc(i.name)} ×${i.qty}`).join("، ")}</div>
        <div style="margin-top:4px;font-weight:700;color:var(--gold)">الإجمالي: ${fmt(o.total)}</div>
      </div>`).join("") : `<p class="empty">لا توجد طلبات مسجلة على هذا الجهاز</p>`;
  }catch(e){ $("#myOrdBox").innerHTML = `<p class="empty">تعذر تحميل الطلبات</p>`; }
}

function cartHtml(){
  if(!cart.length) return `<div class="empty" style="padding-top:60px">${ic("cart")}<p style="margin-top:10px">سلتك فاضية</p></div>`;
  const sub = cart.reduce((a,i)=>a+i.price*i.qty,0);
  return `<p class="note">الرجاء التأكد من أن الأرقام متاحة معكم لأنه سيتم التواصل معكم لتأكيد الأوردر وفي حالة عدم الرد يعتبر الأوردر ملغي وشكرًا</p>
  ${cart.map((i,k)=>`<div class="it" style="animation-delay:${k*70}ms"><div class="im"><img src="${esc(i.img||ph("سعي"))}" alt=""><em>${i.qty}</em></div>
    <div class="in"><b>${esc(i.name)}</b><small>${esc(i.size)}</small></div><div class="pp">${fmt(i.price*i.qty)}</div><button class="rm" data-rm="${k}">${ic("x")}</button></div>`).join("")}
  <div class="sum glass"><div><span>Subtotal</span><span id="sSub">${fmt(sub)}</span></div><div><span>Shipping</span><span id="sShip">?</span></div><div class="tot"><span>Total</span><span id="sTot">${fmt(sub)}</span></div></div>
  <form id="ofm" novalidate>
    <div class="fl">الإسم<i>*</i></div><div class="fi" data-f><span class="ico">${ic("user")}</span><input name="name" placeholder="الاسم" autocomplete="name"></div>
    <div class="fl">رقم التليفون<i>*</i></div><div class="fi" data-f><span class="ico">${ic("phone")}</span><input name="phone" type="tel" inputmode="tel" placeholder="الهاتف" autocomplete="tel"></div>
    <div class="fl">المحافظة<i>*</i></div><div class="fi" data-f><select name="gov" style="padding-inline:12px"><option value="">المحافظة</option>${GOVS.map(g=>`<option>${g}</option>`).join("")}</select></div>
    <div class="fl">العنوان بالتفصيل<i>*</i></div><div class="fi" data-f><span class="ico">${ic("pin")}</span><input name="addr" placeholder="العنوان كاملا" autocomplete="street-address"></div>
    <div class="fl">أي ملاحظات للأوردر</div><div class="fi"><span class="ico">${ic("note")}</span><input name="note" placeholder="ملاحظة أو تنويه"></div>
    <button class="btn d" type="submit" id="sendBtn" style="margin-top:22px">BUY IT NOW - <span id="sBtnT">${fmt(sub)}</span> ${ic("bag")}</button>
  </form>`;
}
function openCart(){ openSheet(cartHtml()); bindForm(); }
function bindForm(){
  const f=$("#ofm"); if(!f) return;
  const ship=()=>{const g=f.gov.value,sub=cart.reduce((a,i)=>a+i.price*i.qty,0);const sh=g?Number(settings.shipping)||0:null;
    $("#sShip").textContent = sh===null?"?":fmt(sh); $("#sTot").textContent=$("#sBtnT").textContent=fmt(sub+(sh||0))};
  f.gov.onchange = ship;
  f.onsubmit = async e => {
    e.preventDefault(); let bad=false;
    f.querySelectorAll("[data-f]").forEach(w=>{const el=w.querySelector("input,select");const v=el.value.trim();const no=!v||(el.name==="phone"&&!/^\+?\d{10,14}$/.test(v.replace(/[\s-]/g,"")));w.classList.remove("err");if(no){void w.offsetWidth;w.classList.add("err");bad=true}});
    if(bad) return toast("من فضلك أكمل البيانات المطلوبة");
    const sub=cart.reduce((a,i)=>a+i.price*i.qty,0), sh=Number(settings.shipping)||0;
    const order={name:f.name.value.trim(),phone:f.phone.value.trim(),gov:f.gov.value,address:f.addr.value.trim(),note:f.note.value.trim(),items:[...cart],subtotal:sub,shipping:sh,total:sub+sh,status:"قيد المراجعة",createdAt:Date.now()};
    const btn=$("#sendBtn"); btn.disabled=true; btn.style.opacity=.7;
    let id="", fullKey="";
    try{ const r=await api("orders","POST",order); fullKey=r.name; id=r.name.slice(-6).toUpperCase(); }catch(err){ btn.disabled=false;btn.style.opacity=1; return toast("حصل خطأ، حاول مرة أخرى"); }
    myOrderIds.push(fullKey);
    store.set("saay_orders", myOrderIds);
    cart=[]; saveCart();
    const itemsDetails = order.items.map(i => `• ${i.name} ${i.size?`(${i.size})`:""} × ${i.qty} = ${i.price*i.qty} جنيه`).join("\n");
    const msg=encodeURIComponent(`طلب جديد #${id}\nالحالة: قيد المراجعة\n━━━━━━━━━━━━━━\nالمنتجات:\n${itemsDetails}\n━━━━━━━━━━━━━━\nالاسم: ${order.name}\nالموبايل: ${order.phone}\nالمحافظة: ${order.gov}\nالعنوان: ${order.address}\nالإجمالي: ${order.total} جنيه`);
    $("#sheet").innerHTML=`<div class="grab"></div><button class="x glass" onclick="closeSheet()">${ic("x")}</button><div class="ok"><div class="ck"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></div><h2>تم استلام طلبك!</h2><p style="margin:8px 0"><span class="st-pill">قيد المراجعة</span></p><p style="color:var(--mute);margin:8px 0 4px">رقم الطلب <b dir="ltr" style="color:#fff">#${id}</b></p><p style="color:var(--mute)">هنتواصل معاك قريب لتأكيد الأوردر</p>
    <a class="btn p" target="_blank" href="https://wa.me/${WHATSAPP}?text=${msg}">${ic("wa")} إرسال الطلب على واتساب</a><button class="btn g" onclick="closeSheet()">متابعة التسوق</button></div>`;
  };
}
document.addEventListener("click",e=>{const r=e.target.closest("[data-rm]");if(r){cart.splice(+r.dataset.rm,1);saveCart();openCartKeep()}});
function openCartKeep(){const s=$("#sheet"),y=s.scrollTop;s.innerHTML=`<div class="grab"></div><button class="x glass" onclick="closeSheet()">${ic("x")}</button>`+cartHtml();bindForm();s.scrollTop=y;}

function lbOpen(){const p=byId(cur.pid);$("#lbImg").src=p.images[cur.img]||"";$("#lb").classList.add("show")}
function lbClose(){$("#lb").classList.remove("show")}
$("#lb").onclick=e=>{if(e.target.id==="lb")lbClose()};

updBadge();
route();
load().then(()=>{ route(); });
</script>
