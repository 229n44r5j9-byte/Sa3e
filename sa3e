<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0b0714">
<title>سعي | Saay</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&family=Reem+Kufi:wght@500;700&family=Poppins:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0b0714; --txt:#f5f2ff; --mute:#a9a2c4; --acc:#a855f7; --acc2:#7c3aed; --red:#ff5a7a; --gold:#e8c27a;
  --glass:rgba(255,255,255,.07); --glass2:rgba(255,255,255,.12); --line:rgba(255,255,255,.16);
  --ease:cubic-bezier(.32,.72,0,1); --spring:cubic-bezier(.34,1.56,.64,1);
  --safe-b:env(safe-area-inset-bottom,0px); --safe-t:env(safe-area-inset-top,0px);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--txt);font-family:'Tajawal',system-ui,sans-serif;min-height:100vh;overflow-x:hidden;padding-bottom:calc(110px + var(--safe-b))}
body.lock{overflow:hidden}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
input,select,textarea{font:inherit;color:inherit;font-size:16px}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
svg.i{width:1.25em;height:1.25em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}

.aurora{position:fixed;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(120% 80% at 50% 0%,#1a0f33 0%,var(--bg) 60%)}
.aurora i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;filter:blur(70px);opacity:.55;animation:float 18s ease-in-out infinite alternate}
.aurora i:nth-child(1){background:#7c3aed;top:-20vmax;right:-15vmax}
.aurora i:nth-child(2){background:#ec4899;bottom:-25vmax;left:-20vmax;animation-duration:24s;opacity:.35}
.aurora i:nth-child(3){background:#2563eb;top:35%;left:20%;width:40vmax;height:40vmax;animation-duration:30s;opacity:.3}
@keyframes float{to{transform:translate3d(8vmax,6vmax,0) scale(1.15) rotate(30deg)}}

.glass{position:relative;background:linear-gradient(135deg,rgba(255,255,255,.13),rgba(255,255,255,.04));
  -webkit-backdrop-filter:blur(26px) saturate(190%);backdrop-filter:blur(26px) saturate(190%);
  border:1px solid var(--line);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset 0 -1px 0 rgba(255,255,255,.06),inset 0 0 22px rgba(255,255,255,.05),0 10px 34px rgba(0,0,0,.4);
  overflow:hidden}
.glass::before{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;
  background:radial-gradient(180px circle at var(--mx,30%) var(--my,0%),rgba(255,255,255,.28),transparent 60%);opacity:.5;transition:opacity .3s}
.glass:active::before{opacity:1}

.ann{overflow:hidden;white-space:nowrap;padding:calc(9px + var(--safe-t)) 0 9px;font-size:13px;font-weight:700;background:linear-gradient(90deg,#4c1d95,#7c3aed,#4c1d95);background-size:200% 100%;animation:shine 8s linear infinite}
.ann div{display:inline-block;animation:marq 22s linear infinite}
.ann span{margin:0 22px}.ann span::before{content:"•";margin-inline-end:22px;opacity:.7}
@keyframes marq{to{transform:translateX(50%)}}
@keyframes shine{to{background-position:200% 0}}

header{position:sticky;top:10px;z-index:30;margin:10px 12px 0;border-radius:26px;display:flex;align-items:center;justify-content:space-between;padding:10px 16px}
.logo{font-family:'Reem Kufi',serif;font-size:30px;font-weight:700;line-height:1;background:linear-gradient(120deg,#fff,var(--gold),#fff);background-size:200%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 6s linear infinite;display:flex;flex-direction:column;align-items:center}
.logo small{font-family:'Poppins';font-size:8px;letter-spacing:4px;color:var(--mute);-webkit-text-fill-color:var(--mute);margin-top:2px}
.ic-btn{position:relative;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;transition:transform .3s var(--spring)}
.ic-btn:active{transform:scale(.85)}
.badge{position:absolute;top:-2px;inset-inline-end:-2px;min-width:18px;height:18px;border-radius:9px;background:var(--acc);font:700 11px 'Poppins';display:grid;place-items:center;padding:0 4px;box-shadow:0 0 12px var(--acc)}
.bump{animation:bump .5s var(--spring)}
@keyframes bump{40%{transform:scale(1.5) rotate(-8deg)}}

main{max-width:760px;margin:0 auto;padding:0 14px}
.view{animation:enter .6s var(--ease) both}
@keyframes enter{from{opacity:0;transform:translateY(26px) scale(.98);filter:blur(6px)}}
.rv{opacity:0;transform:translateY(34px) scale(.97);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.rv.in{opacity:1;transform:none}

.hero{margin-top:16px;border-radius:30px;height:230px;position:relative;display:flex;align-items:flex-end;padding:22px}
.hero .bg{position:absolute;inset:0;background-size:cover;background-position:center;transform:scale(1.15);animation:kb 14s ease-in-out infinite alternate}
@keyframes kb{to{transform:scale(1.02) translateY(-8px)}}
.hero .shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(11,7,20,.85),transparent 70%)}
.hero h1{position:relative;font-size:28px;font-weight:800;line-height:1.35;text-shadow:0 4px 20px rgba(0,0,0,.6)}
.hero h1 em{font-style:normal;color:var(--gold)}
.hero p{position:relative;color:#e7defc;font-size:14px;margin-top:4px}

.sec-title{text-align:center;font-size:25px;font-weight:800;margin:46px 0 22px;position:relative}
.sec-title::after{content:"";display:block;width:54px;height:4px;border-radius:4px;background:linear-gradient(90deg,var(--acc),var(--gold));margin:10px auto 0;animation:grow 1.2s var(--ease) both}
@keyframes grow{from{width:0}}

.rev{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 14px;scrollbar-width:none}
.rev::-webkit-scrollbar{display:none}
.rev .glass{flex:0 0 78%;max-width:300px;border-radius:24px;scroll-snap-align:center;aspect-ratio:3/4;transition:transform .5s var(--ease)}
.rev img{width:100%;height:100%;object-fit:cover}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(min-width:640px){.grid{grid-template-columns:repeat(3,1fr)}}
.card{border-radius:24px;padding:8px 8px 14px;cursor:pointer;transition:transform .5s var(--ease);transform-style:preserve-3d;will-change:transform}
.card:active{transform:scale(.97)}
.card .ph{position:relative;aspect-ratio:3/4;border-radius:18px;overflow:hidden;background:#1b1230}
.card .ph img{width:100%;height:100%;object-fit:cover;transition:transform .9s var(--ease)}
.card:hover .ph img{transform:scale(1.09)}
.tag{position:absolute;top:8px;inset-inline-end:8px;background:linear-gradient(135deg,var(--acc2),var(--acc));font:700 11px 'Poppins';padding:4px 8px;border-radius:9px;direction:ltr;box-shadow:0 4px 14px rgba(124,58,237,.6);z-index:2}
.qa{position:absolute;bottom:8px;inset-inline-start:8px;width:38px;height:38px;border-radius:50%;z-index:2;display:grid;place-items:center;transition:transform .35s var(--spring)}
.qa:active{transform:scale(.8) rotate(-12deg)}
.card h3{font-size:14px;font-weight:700;margin:12px 6px 4px;line-height:1.5}
.pr{margin:0 6px;font:600 13px 'Poppins';direction:rtl;text-align:right}
.pr b{color:var(--red);font-weight:600}.pr s{color:var(--mute);margin-inline-start:6px;font-size:12px}
.card .sold{position:absolute;inset:0;background:rgba(11,7,20,.7);display:grid;place-items:center;font-weight:800;z-index:3}

.back{display:inline-flex;align-items:center;gap:6px;margin:16px 0 4px;padding:8px 14px;border-radius:20px;font-size:13px}
.gal{border-radius:28px;padding:8px;margin-top:8px}
.gal .main{position:relative;aspect-ratio:3/4;border-radius:22px;overflow:hidden;background:#1b1230;touch-action:pan-y}
.gal .main img{width:100%;height:100%;object-fit:cover;animation:fadeimg .6s var(--ease)}
@keyframes fadeimg{from{opacity:0;transform:scale(1.06)}}
.gal .exp{position:absolute;bottom:10px;inset-inline-start:10px;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;z-index:2}
.thumbs{display:flex;gap:8px;justify-content:center;margin-top:10px}
.thumbs button{width:64px;aspect-ratio:3/4;border-radius:12px;overflow:hidden;opacity:.55;border:2px solid transparent;transition:.35s var(--ease)}
.thumbs button.on{opacity:1;border-color:var(--acc);transform:translateY(-4px);box-shadow:0 8px 20px rgba(168,85,247,.45)}
.thumbs img{width:100%;height:100%;object-fit:cover}
.ptitle{font-size:34px;font-weight:800;line-height:1.3;margin:26px 0 8px}
.pprice{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font:600 21px 'Poppins'}
.pprice b{color:var(--red)}.pprice s{color:var(--mute);font-size:17px}
.save{display:inline-block;margin-top:10px;padding:5px 12px;border-radius:10px;font:600 12px 'Poppins';background:linear-gradient(135deg,var(--acc2),var(--acc));box-shadow:0 6px 18px rgba(124,58,237,.5)}
.opt{margin-top:22px;font-weight:700;font-size:14px}
.opt .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.chip{padding:10px 16px;border-radius:16px;font-size:13px;transition:.35s var(--spring);border:1px solid var(--line);background:var(--glass)}
.chip.on{background:linear-gradient(135deg,var(--acc2),var(--acc));border-color:transparent;transform:scale(1.05);box-shadow:0 8px 22px rgba(124,58,237,.55)}
.qty{display:inline-flex;align-items:center;gap:18px;margin:22px 0 14px;padding:6px 10px;border-radius:30px;font:600 17px 'Poppins'}
.qty button{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;transition:transform .3s var(--spring)}
.qty button:active{transform:scale(.75)}
.qty span{min-width:22px;text-align:center}
.btn{position:relative;overflow:hidden;width:100%;padding:16px;border-radius:30px;font-weight:800;font-size:16px;display:flex;align-items:center;justify-content:center;gap:10px;margin-top:12px;transition:transform .3s var(--spring),box-shadow .3s}
.btn:active{transform:scale(.96)}
.btn.p{background:linear-gradient(135deg,var(--acc2),var(--acc));box-shadow:0 12px 30px rgba(124,58,237,.55),inset 0 1px 0 rgba(255,255,255,.4)}
.btn.d{background:linear-gradient(135deg,#fff,#d9cffa);color:#14091f;box-shadow:0 12px 30px rgba(255,255,255,.18)}
.btn.g{background:var(--glass2);border:1px solid var(--line);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px)}
.btn.p::after,.btn.d::after{content:"";position:absolute;top:0;bottom:0;width:60px;left:-80px;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);animation:sweep 3.2s ease-in-out infinite}
@keyframes sweep{60%,100%{left:120%}}
.rip{position:absolute;border-radius:50%;background:rgba(255,255,255,.45);transform:scale(0);animation:rip .7s ease-out forwards;pointer-events:none}
@keyframes rip{to{transform:scale(4);opacity:0}}
.stock{text-align:center;margin:20px 0;font-size:15px;color:#d8ccff}
.stock b{color:var(--gold)}
.desc{margin-top:8px;padding:18px;border-radius:22px;line-height:1.9;color:#ddd5f5;font-size:14px}

.nav{position:fixed;bottom:calc(14px + var(--safe-b));left:50%;transform:translateX(-50%);z-index:40;width:min(92vw,420px);border-radius:34px;display:flex;padding:7px}
.nav button{flex:1;position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 0 7px;font-size:11px;font-weight:700;color:var(--mute);transition:color .3s}
.nav button.on{color:#fff}
.nav .pill{position:absolute;top:7px;bottom:7px;width:calc(33.33% - 4.6px);border-radius:28px;background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.08));box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 4px 16px rgba(168,85,247,.35);transition:transform .55s var(--spring);inset-inline-start:7px}
.nav .badge{top:2px;inset-inline-end:calc(50% - 22px)}
.wa{position:fixed;z-index:39;inset-inline-start:14px;bottom:calc(92px + var(--safe-b));height:52px;padding:0 18px 0 14px;border-radius:30px;display:flex;align-items:center;gap:10px;font-weight:700;font-size:13px;animation:pop .8s var(--spring) .8s both}
.wa .dot{width:34px;height:34px;border-radius:50%;background:#25d366;display:grid;place-items:center;color:#fff;box-shadow:0 0 0 0 rgba(37,211,102,.7);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 14px rgba(37,211,102,0)}}
@keyframes pop{from{transform:scale(0) translateY(30px);opacity:0}}
.up{position:fixed;z-index:39;inset-inline-end:14px;bottom:calc(92px + var(--safe-b));width:48px;height:48px;border-radius:16px;display:grid;place-items:center;opacity:0;transform:translateY(20px) scale(.7);pointer-events:none;transition:.5s var(--spring)}
.up.show{opacity:1;transform:none;pointer-events:auto}

.ov{position:fixed;inset:0;z-index:60;background:rgba(5,2,12,.55);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);opacity:0;pointer-events:none;transition:opacity .45s}
.ov.show{opacity:1;pointer-events:auto}
.sheet{position:fixed;z-index:61;bottom:0;left:50%;width:min(100%,560px);max-height:92vh;overflow-y:auto;border-radius:34px 34px 0 0;padding:14px 18px calc(28px + var(--safe-b));transform:translate(-50%,105%);transition:transform .65s var(--ease);background:linear-gradient(160deg,rgba(40,24,72,.82),rgba(14,8,28,.9))}
.sheet.show{transform:translate(-50%,0)}
.grab{width:42px;height:5px;border-radius:5px;background:var(--line);margin:0 auto 14px}
.sheet .x{position:absolute;top:16px;inset-inline-start:16px;width:36px;height:36px;border-radius:50%;display:grid;place-items:center}
.note{font-size:14px;line-height:1.9;margin:0 0 18px;padding-inline-start:46px;color:#e6defb}
.it{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);animation:enter .5s var(--ease) both}
.it .im{position:relative;width:58px;aspect-ratio:3/4;border-radius:12px;overflow:visible;flex:none}
.it .im img{width:100%;height:100%;object-fit:cover;border-radius:12px}
.it .im em{position:absolute;top:-6px;inset-inline-end:-6px;width:20px;height:20px;border-radius:50%;background:var(--acc);font:700 11px 'Poppins';display:grid;place-items:center;font-style:normal}
.it .in{flex:1}.it .in b{display:block;font-size:14px}.it .in small{color:var(--mute);font-size:12px}
.it .pp{font:600 13px 'Poppins';direction:ltr}
.it .rm{width:28px;height:28px;border-radius:50%;background:var(--glass);display:grid;place-items:center;color:var(--mute)}
.sum{margin:16px 0;border-radius:20px;padding:6px 16px}
.sum div{display:flex;justify-content:space-between;padding:10px 0;font:600 14px 'Poppins'}
.sum div+div{border-top:1px solid var(--line)}
.sum div span:first-child{font-family:'Tajawal'}
.sum .tot{font-size:17px;font-weight:700}
.fl{margin-top:16px;font-weight:700;font-size:14px}.fl i{color:var(--red);font-style:normal}
.fi{display:flex;margin-top:8px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.06);overflow:hidden;transition:.3s}
.fi:focus-within{border-color:var(--acc);box-shadow:0 0 0 4px rgba(168,85,247,.25);background:rgba(255,255,255,.1)}
.fi .ico{width:50px;display:grid;place-items:center;background:var(--glass2);color:var(--mute)}
.fi input,.fi select,.fi textarea{flex:1;min-width:0;background:none;border:0;outline:0;padding:14px;font-size:16px}
.fi select option{background:#1b1230;color:#fff}
.fi.err{border-color:var(--red);animation:shake .4s}
@keyframes shake{25%{transform:translateX(7px)}75%{transform:translateX(-7px)}}
.empty{text-align:center;padding:40px 0;color:var(--mute)}
.ok{text-align:center;padding:20px 0}
.ok .ck{width:92px;height:92px;margin:10px auto 18px;border-radius:50%;background:linear-gradient(135deg,#22c55e,#16a34a);display:grid;place-items:center;animation:pop .8s var(--spring);box-shadow:0 0 50px rgba(34,197,94,.55)}
.ok .ck svg{width:48px;height:48px;stroke:#fff;stroke-width:3;fill:none;stroke-dasharray:50;stroke-dashoffset:50;animation:draw .7s .4s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.st-pill{display:inline-block;padding:5px 12px;border-radius:12px;font-size:12px;font-weight:800;background:rgba(232,194,122,.16);color:var(--gold);border:1px solid rgba(232,194,122,.35)}
.lb{position:fixed;inset:0;z-index:80;background:rgba(5,2,12,.92);display:none;place-items:center;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.lb.show{display:grid;animation:fadeimg .4s}
.lb img{max-width:94vw;max-height:88vh;border-radius:20px}
.lb button{position:absolute;top:calc(18px + var(--safe-t));inset-inline-start:18px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center}
footer{margin:60px 0 10px;text-align:center;color:var(--mute);font-size:13px;line-height:2}
footer .logo{font-size:36px;margin-bottom:6px}
.toast{position:fixed;top:calc(16px + var(--safe-t));left:50%;transform:translate(-50%,-140%);z-index:90;padding:12px 22px;border-radius:30px;font-weight:700;font-size:14px;transition:transform .6s var(--spring);white-space:nowrap}
.toast.show{transform:translate(-50%,0)}
.skel{background:linear-gradient(90deg,#1b1230 25%,#2a1c4a 50%,#1b1230 75%);background-size:200% 100%;animation:shine 1.4s linear infinite;border-radius:24px;aspect-ratio:3/4.6}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute"><defs>
<symbol id="cart" viewBox="0 0 24 24"><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2 3h3l2.6 12.2a1.6 1.6 0 0 0 1.6 1.3h8.1a1.6 1.6 0 0 0 1.6-1.2L21 8H6"/></symbol>
<symbol id="home" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></symbol>
<symbol id="menu" viewBox="0 0 24 24"><path d="M3 7h18M3 12h18M3 17h18"/></symbol>
<symbol id="x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></symbol>
<symbol id="plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
<symbol id="minus" viewBox="0 0 24 24"><path d="M5 12h14"/></symbol>
<symbol id="bag" viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></symbol>
<symbol id="user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></symbol>
<symbol id="phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
<symbol id="pin" viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></symbol>
<symbol id="note" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 10h10M7 14h6"/></symbol>
<symbol id="up" viewBox="0 0 24 24"><path d="M6 14l6-6 6 6"/></symbol>
<symbol id="exp" viewBox="0 0 24 24"><path d="M4 9V4h5M20 15v5h-5M4 4l6 6M20 20l-6-6"/></symbol>
<symbol id="back" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></symbol>
<symbol id="wa" viewBox="0 0 24 24"><path d="M3 21l1.6-4.6A8.5 8.5 0 1 1 8 19.5z"/><path d="M9 9c0 3 3 6 6 6l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2z"/></symbol>
</defs></svg>

<div class="aurora"><i></i><i></i><i></i></div>

<div class="ann"><div id="marq"></div></div>
<header class="glass">
  <button class="ic-btn glass" id="hCart" aria-label="السلة"><svg class="i"><use href="#cart"/></svg><span class="badge" id="hBadge" style="display:none">0</span></button>
  <a href="#/" class="logo">سعي<small>SAAY</small></a>
  <button class="ic-btn glass" id="hMenu" aria-label="القائمة"><svg class="i"><use href="#menu"/></svg></button>
</header>

<main id="app"></main>

<a class="wa glass" id="waBtn" target="_blank" rel="noopener"><span class="dot"><svg class="i"><use href="#wa"/></svg></span>تواصل معنا</a>
<button class="up glass" id="up" aria-label="للأعلى"><svg class="i"><use href="#up"/></svg></button>

<nav class="nav glass">
  <span class="pill" id="pill"></span>
  <button data-n="0" id="nCart"><svg class="i"><use href="#cart"/></svg>السلة<span class="badge" id="nBadge" style="display:none">0</span></button>
  <button data-n="1" id="nHome" class="on"><svg class="i"><use href="#home"/></svg>الرئيسية</button>
